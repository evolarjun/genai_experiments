# Parse a single CSV line according to RFC 4180 rules.
# $line          : string containing CSV line
# $get_next_line : optional coderef returning next line string or undef on EOF (for multi-line fields)
# Returns arrayref of unquoted, unescaped field values.
sub parse_csv_line {
    my ($line, $get_next_line) = @_;
    return [''] unless defined $line;

    $line =~ s/\r?\n$//;
    my @fields;
    my $curr_field = '';
    my $in_quotes  = 0;
    my $i          = 0;

    while (1) {
        if ($i >= length($line)) {
            if ($in_quotes && defined $get_next_line) {
                my $next = $get_next_line->();
                if (defined $next) {
                    $next =~ s/\r?\n$//;
                    $curr_field .= "\\n";
                    $line = $next;
                    $i    = 0;
                    next;
                }
            }
            # Reached end of line (or EOF with unclosed quote)
            push @fields, $curr_field;
            last;
        }

        my $ch = substr($line, $i, 1);

        if ($in_quotes) {
            if ($ch eq '"') {
                if ($i + 1 < length($line) && substr($line, $i + 1, 1) eq '"') {
                    $curr_field .= '"';
                    $i += 2;
                } else {
                    $in_quotes = 0;
                    $i++;
                }
            } else {
                $curr_field .= $ch;
                $i++;
            }
        } else {
            if ($ch eq ',') {
                push @fields, $curr_field;
                $curr_field = '';
                $i++;
            } elsif ($ch eq '"' && $curr_field eq '') {
                $in_quotes = 1;
                $i++;
            } else {
                $curr_field .= $ch;
                $i++;
            }
        }
    }

    return \@fields;
}

# Clamp $val to [$lo, $hi].
sub clamp {
    my ($val, $lo, $hi) = @_;
    return $lo if $val < $lo;
    return $hi if $val > $hi;
    return $val;
}

# Format a single cell into a fixed-width byte string.
# Long values are truncated with '>'; short values are padded.
# Numeric columns are right-aligned; text columns are left-aligned.
sub format_cell {
    my ($val, $width, $is_numeric) = @_;
    $val //= '';
    if (length($val) > $width) {
        $val = substr($val, 0, $width - 1) . '>';
    }
    return $is_numeric
        ? sprintf("%${width}s",  $val)   # right-align
        : sprintf("%-${width}s", $val);  # left-align
}

# Format a line number prefix for a row.
# $row_idx   : 0-based data row index, or undef for header/colnum rows
# $total_rows: total number of data rows
# Returns string of length length($total_rows) + 1
sub format_line_num {
    my ($row_idx, $total_rows) = @_;
    my $width = length($total_rows // 1);
    if (defined $row_idx) {
        return sprintf("%${width}d ", $row_idx + 1);
    } else {
        return ' ' x ($width + 1);
    }
}

# Format reverse yellow prompt line for line-number option toggle
sub format_option_prompt {
    my ($show_line_nums, $term_cols) = @_;
    my $REVERSE_YELLOW = "\e[7;33m";
    my $RESET          = "\e[0m";
    my $msg = $show_line_nums
        ? "Don't use line numbers  (press RETURN)"
        : "Constantly display line numbers  (press RETURN)";
    if (length($msg) > $term_cols) {
        $msg = substr($msg, 0, $term_cols);
    } else {
        $msg .= ' ' x ($term_cols - length($msg));
    }
    return $REVERSE_YELLOW . $msg . $RESET;
}

# Search data rows cell-by-cell for regex match.
# $rows_ref : arrayref of data row arrayrefs
# $n_cols   : number of columns
# $regex    : compiled regex object (qr//)
# Returns arrayref of [row_idx, col_idx] tuples.
# Search data rows cell-by-cell or full-line for regex match.
# $rows_ref : arrayref of data row arrayrefs
# $n_cols   : number of columns
# $regex    : compiled regex object (qr//)
# $opt_delim: field delimiter string (default: "\t")
# Returns arrayref of [row_idx, col_idx] tuples (deduplicated per row).
sub find_matches {
    my ($rows_ref, $n_cols, $regex, $opt_delim) = @_;
    $opt_delim //= "\t";
    my @matches;
    return \@matches unless defined $regex && @$rows_ref;

    for my $ri (0 .. $#$rows_ref) {
        my $row  = $rows_ref->[$ri];
        my $line = join($opt_delim, @$row);

        # Precompute character ranges for each column in $line
        my @col_ranges;
        my $pos_idx = 0;
        my $d_len   = length($opt_delim);
        for my $ci (0 .. $n_cols - 1) {
            my $val_len = ($ci < @$row && defined $row->[$ci]) ? length($row->[$ci]) : 0;
            my $start   = $pos_idx;
            my $end     = $start + max(0, $val_len - 1);
            push @col_ranges, [$start, $end];
            $pos_idx += $val_len + $d_len;
        }

        my %seen_col;
        while ($line =~ /$regex/g) {
            my $m_start = $-[0];

            # Guard against zero-width matches causing infinite loop
            if ($+[0] == $-[0]) {
                pos($line) = $-[0] + 1;
            }

            # Map m_start to column index (column where match start falls)
            my $matched_col = $n_cols - 1;
            for my $ci (0 .. $n_cols - 1) {
                if ($ci == $n_cols - 1 || $m_start < $col_ranges[$ci + 1]->[0]) {
                    $matched_col = $ci;
                    last;
                }
            }

            if (!$seen_col{$matched_col}++) {
                push @matches, [$ri, $matched_col];
            }
        }
    }
    return \@matches;
}

# Filter row indices by matching joined full-line string against a regex pattern.
# $rows_ref : arrayref of data row arrayrefs
# $regex    : compiled regex object (qr//) or undef
# $opt_delim: field delimiter string (default: "\t")
# Returns arrayref of matching row indices.
sub filter_rows {
    my ($rows_ref, $regex, $opt_delim) = @_;
    return [(0 .. $#$rows_ref)] unless defined $regex && @$rows_ref;
    $opt_delim //= "\t";
    my @indices;
    for my $i (0 .. $#$rows_ref) {
        my $row  = $rows_ref->[$i];
        my $line = join($opt_delim, @$row);
        if ($line =~ $regex) {
            push @indices, $i;
        }
    }
    return \@indices;
}

# Find index in $matches_ref relative to ($curr_row, $curr_col).
# $direction: +1 for forward/next, -1 for backward/prev
# Returns ($match_array_index, $wrapped_flag)
sub find_next_match_index {
    my ($matches_ref, $curr_row, $curr_col, $direction) = @_;
    return (undef, 0) unless defined $matches_ref && @$matches_ref;
    $direction //= 1;

    if ($direction > 0) {
        for my $i (0 .. $#$matches_ref) {
            my ($r, $c) = @{$matches_ref->[$i]};
            if ($r > $curr_row || ($r == $curr_row && $c > $curr_col)) {
                return ($i, 0);
            }
        }
        # Wrap to start
        return (0, 1);
    } else {
        for (my $i = $#$matches_ref; $i >= 0; $i--) {
            my ($r, $c) = @{$matches_ref->[$i]};
            if ($r < $curr_row || ($r == $curr_row && $c < $curr_col)) {
                return ($i, 0);
            }
        }
        # Wrap to end
        return ($#$matches_ref, 1);
    }
}

# Build and clip a data row display line, applying cell match highlights.
# $fields_ref     : arrayref of field values
# $col_widths_ref : arrayref of column widths
# $is_numeric_ref : arrayref of numeric flags
# $h_offset       : horizontal offset
# $width          : viewport content width
# $row_idx        : data row index (0-based)
# $search_regex   : compiled regex (qr//) or undef
# $active_match   : [active_row_idx, active_col_idx] or undef
# $opt_delim      : field delimiter string (default: "\t")
# $is_hidden_ref  : arrayref of column hidden flags or undef
# Returns clipped display string (with ANSI highlight escape codes if matching).
sub render_clipped_row {
    my ($fields_ref, $col_widths_ref, $is_numeric_ref, $h_offset, $width, $row_idx, $search_regex, $active_match, $opt_delim, $is_hidden_ref) = @_;
    $opt_delim //= "\t";

    my $output       = '';
    my $printed_len  = 0;
    my $curr_pos     = 0;
    my $active_row   = defined $active_match ? $active_match->[0] : -1;
    my $active_col   = defined $active_match ? $active_match->[1] : -1;

    # Precompute overlapping columns for search_regex on full line
    my %overlapping_cols;
    if (defined $search_regex) {
        my $line = join($opt_delim, @$fields_ref);
        my @col_ranges;
        my $pos_idx = 0;
        my $d_len   = length($opt_delim);
        for my $ci (0 .. $#$col_widths_ref) {
            my $val_len = ($ci < @$fields_ref && defined $fields_ref->[$ci]) ? length($fields_ref->[$ci]) : 0;
            my $start   = $pos_idx;
            my $end     = $start + max(0, $val_len - 1);
            push @col_ranges, [$start, $end, $val_len];
            $pos_idx += $val_len + $d_len;
        }

        while ($line =~ /$search_regex/g) {
            my $m_start = $-[0];
            my $m_end   = $+[0] - 1;

            if ($+[0] == $-[0]) {
                pos($line) = $-[0] + 1;
            }

            for my $ci (0 .. $#$col_widths_ref) {
                my ($c_start, $c_end, $val_len) = @{$col_ranges[$ci]};
                if ($val_len > 0) {
                    if ($m_start <= $c_end && $m_end >= $c_start) {
                        $overlapping_cols{$ci} = 1;
                    }
                } else {
                    if ($m_start <= $c_start && $m_end >= $c_start) {
                        $overlapping_cols{$ci} = 1;
                    }
                }
            }
        }
    }

    for my $ci (0 .. $#$col_widths_ref) {
        last if $printed_len >= $width;

        my $col_w     = $col_widths_ref->[$ci];
        my $val       = $fields_ref->[$ci] // '';
        my $is_hidden = ($is_hidden_ref && $is_hidden_ref->[$ci]);
        my $cell      = $is_hidden ? '|' : format_cell($val, $col_w, $is_numeric_ref->[$ci]);

        # Cell spans logical positions [$curr_pos, $curr_pos + $col_w - 1]
        my $cell_start = $curr_pos;
        my $cell_end   = $curr_pos + $col_w - 1;

        # Check overlap with viewport [$h_offset, $h_offset + $width - 1]
        my $v_start = max($cell_start, $h_offset);
        my $v_end   = min($cell_end, $h_offset + $width - 1);

        if ($v_start <= $v_end) {
            my $cell_vis = substr($cell, $v_start - $cell_start, $v_end - $v_start + 1);

            if (defined $search_regex && $overlapping_cols{$ci}) {
                if ($row_idx == $active_row && $ci == $active_col) {
                    $output .= "\e[42;30m$cell_vis\e[0m";  # active: black on green bg
                } else {
                    $output .= "\e[32m$cell_vis\e[0m";     # other match: green text
                }
            } else {
                $output .= $cell_vis;
            }
            $printed_len += length($cell_vis);
        }

        $curr_pos += $col_w;

        # Separator space after column
        if ($ci < $#$col_widths_ref) {
            my $sep_pos = $curr_pos;
            if ($sep_pos >= $h_offset && $printed_len < $width) {
                $output .= ' ';
                $printed_len++;
            }
            $curr_pos++;
        }
    }

    # Pad remaining width with spaces
    if ($printed_len < $width) {
        $output .= ' ' x ($width - $printed_len);
    }

    return $output;
}

# Compute horizontal scroll offset for a target column during search.
# Returns 0 if the entire field fits in viewport at offset 0;
# otherwise centers the field within viewport content width.
sub compute_search_h_offset {
    my ($col_start, $col_w, $content_w, $max_h) = @_;
    my $col_end = $col_start + $col_w - 1;
    if ($col_end < $content_w) {
        return 0;
    }
    my $target_h = $col_start - int(($content_w - $col_w) / 2);
    return clamp($target_h, 0, $max_h);
}

# Build the full (unclipped) display string for one row of cells.
# $fields_ref     : arrayref of field values (already padded to n_cols length)
# $col_widths_ref : arrayref of per-column widths
# $is_numeric_ref : arrayref of per-column numeric flags
# $is_hidden_ref  : arrayref of per-column hidden flags or undef
sub build_row_line {
    my ($fields_ref, $col_widths_ref, $is_numeric_ref, $is_hidden_ref) = @_;
    my @cells;
    for my $ci (0 .. $#$col_widths_ref) {
        my $is_hidden = ($is_hidden_ref && $is_hidden_ref->[$ci]);
        my $cell = $is_hidden ? '|' : format_cell(
            $fields_ref->[$ci],
            $col_widths_ref->[$ci],
            $is_numeric_ref->[$ci],
        );
        push @cells, $cell;
    }
    return join(' ', @cells);
}

# Build the full display string for the column-number row.
# Alignment matches each column's alignment (left for text, right for numeric).
# $base_idx: starting column index (default: 1)
# $is_hidden_ref: arrayref of per-column hidden flags or undef
sub build_colnum_line {
    my ($col_widths_ref, $is_numeric_ref, $base_idx, $is_hidden_ref) = @_;
    $base_idx //= 1;
    $is_numeric_ref //= [(1) x scalar(@$col_widths_ref)];
    my @cells;
    for my $ci (0 .. $#$col_widths_ref) {
        my $is_hidden = ($is_hidden_ref && $is_hidden_ref->[$ci]);
        my $cell = $is_hidden ? '|' : format_cell($ci + $base_idx, $col_widths_ref->[$ci], $is_numeric_ref->[$ci]);
        push @cells, $cell;
    }
    return join(' ', @cells);
}

# Adjust column widths based on user input string.
# $orig_widths_ref : arrayref of original full column widths
# $curr_widths_ref : arrayref of current column widths (modified in-place)
# $is_hidden_ref   : arrayref of column hidden flags (0 or 1, modified in-place)
# $header_ref      : arrayref of header strings
# $input           : user input string ('', '<col>', '<col>:<width>', '<col>:0')
# $n_cols          : number of columns
# Returns ($success, $status_message)
sub adjust_column_widths {
    my ($orig_widths_ref, $curr_widths_ref, $is_hidden_ref, $header_ref, $input, $n_cols) = @_;
    $input //= '';
    $input =~ s/^\s+|\s+$//g;

    # 1. Empty input resets all columns to original widths
    if ($input eq '') {
        for my $i (0 .. $n_cols - 1) {
            $curr_widths_ref->[$i] = $orig_widths_ref->[$i];
            $is_hidden_ref->[$i]   = 0;
        }
        return (1, "Reset all columns to original widths");
    }

    # 2. <col_num>:<width>
    if ($input =~ /^(\d+)\s*:\s*(\d+)$/) {
        my ($col_num, $w) = ($1, $2);
        if ($col_num < 1 || $col_num > $n_cols) {
            return (0, "Invalid column number: $col_num");
        }
        my $ci = $col_num - 1;
        if ($w == 0) {
            $curr_widths_ref->[$ci] = 1;
            $is_hidden_ref->[$ci]   = 1;
            return (1, "Hidden column $col_num");
        } else {
            $curr_widths_ref->[$ci] = $w;
            $is_hidden_ref->[$ci]   = 0;
            return (1, "Set column $col_num width to $w");
        }
    }

    # 3. <col_num> (toggle)
    if ($input =~ /^(\d+)$/) {
        my $col_num = $1;
        if ($col_num < 1 || $col_num > $n_cols) {
            return (0, "Invalid column number: $col_num");
        }
        my $ci = $col_num - 1;
        # If already modified (width != orig or hidden == 1), restore to orig
        if ($curr_widths_ref->[$ci] != $orig_widths_ref->[$ci] || $is_hidden_ref->[$ci]) {
            $curr_widths_ref->[$ci] = $orig_widths_ref->[$ci];
            $is_hidden_ref->[$ci]   = 0;
            return (1, "Restored column $col_num to original width");
        } else {
            my $hw = length($header_ref->[$ci] // '');
            $curr_widths_ref->[$ci] = max(1, $hw);
            $is_hidden_ref->[$ci]   = 0;
            return (1, "Shrunk column $col_num to header width");
        }
    }

    return (0, "Invalid column width specification: $input");
}

# Clip a content string at $h_offset and pad/truncate to exactly $width chars.
sub clip_content {
    my ($content, $h_offset, $width) = @_;
    my $len     = length($content);
    my $visible = ($h_offset < $len) ? substr($content, $h_offset) : '';
    my $vlen    = length($visible);
    if ($vlen < $width) {
        $visible .= ' ' x ($width - $vlen);
    } elsif ($vlen > $width) {
        $visible = substr($visible, 0, $width);
    }
    return $visible;
}

# Compute per-column maximum byte widths from a set of rows.
# Also enforces minimum width equal to the header value width and column-number width.
# $rows_ref   : arrayref of row arrayrefs (data rows only, no header)
# $header_ref : arrayref of header field values
# $n_cols     : number of columns
# $limit      : max rows to scan (undef = all)
# Returns arrayref of widths.
sub compute_col_widths {
    my ($rows_ref, $header_ref, $n_cols, $limit) = @_;
    my @widths;
    for my $ci (0 .. $n_cols - 1) {
        my $col_num_w = length($ci + 1);
        $widths[$ci] = max(length($header_ref->[$ci] // ''), $col_num_w);
    }
    my $max_ri = defined $limit ? min($limit - 1, $#$rows_ref) : $#$rows_ref;
    for my $ri (0 .. $max_ri) {
        my $row = $rows_ref->[$ri];
        for my $ci (0 .. $n_cols - 1) {
            my $len = length($row->[$ci] // '');
            $widths[$ci] = $len if $len > $widths[$ci];
        }
    }
    return \@widths;
}

# Determine which columns are numeric.
# A column is numeric if every non-empty value in the scanned rows matches a
# number pattern (int, float, or scientific notation, with optional sign).
# $rows_ref : arrayref of row arrayrefs (data rows only)
# $n_cols   : number of columns
# $limit    : max rows to scan (undef = all)
# Returns arrayref of booleans (1 = numeric, 0 = text).
sub detect_numeric {
    my ($rows_ref, $n_cols, $limit) = @_;
    my @flags = (1) x $n_cols;
    my $max_ri = defined $limit ? min($limit - 1, $#$rows_ref) : $#$rows_ref;
    for my $ri (0 .. $max_ri) {
        my $row = $rows_ref->[$ri];
        for my $ci (0 .. $n_cols - 1) {
            next unless $flags[$ci];
            my $val = $row->[$ci] // '';
            next if $val eq '';
            $flags[$ci] = 0
                unless $val =~ /^\s*[+-]?(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?\s*$/;
        }
    }
    return \@flags;
}

# Compute total logical line width (all columns + separators).
sub total_line_width {
    my ($col_widths_ref) = @_;
    my $w = 0;
    $w += $_ for @$col_widths_ref;
    $w += max(0, scalar(@$col_widths_ref) - 1);  # spaces between cols
    return $w;
}

# ------------------------------
# HISTORY & LINE EDITING PURE FUNCTIONS
# ------------------------------

# Add an entry to a history arrayref.
# - Ignores undef or empty string
# - Deduplicates by removing any existing occurrence and placing at the end
# - Truncates from the front if exceeding $max_size (default 100)
sub add_to_history {
    my ($history_aref, $entry, $max_size) = @_;
    $max_size //= 100;
    return $history_aref unless defined $entry && $entry ne '';

    # Remove any existing instance
    @$history_aref = grep { $_ ne $entry } @$history_aref;
    push @$history_aref, $entry;

    while (@$history_aref > $max_size) {
        shift @$history_aref;
    }
    return $history_aref;
}

# Load history file (~/.t2v_history or specified path).
# Lines starting with '/' are search history; lines starting with '&' are filter history.
# Returns (\@search_history, \@filter_history).
sub load_history_file {
    my ($filepath) = @_;
    my @search_history;
    my @filter_history;
    return (\@search_history, \@filter_history) unless defined $filepath && -f $filepath;

    if (open my $fh, '<', $filepath) {
        while (my $line = <$fh>) {
            chomp $line;
            next if $line eq '';
            my $prefix = substr($line, 0, 1);
            my $entry  = substr($line, 1);
            if ($prefix eq '/') {
                add_to_history(\@search_history, $entry, 100);
            } elsif ($prefix eq '&') {
                add_to_history(\@filter_history, $entry, 100);
            }
        }
        close $fh;
    }
    return (\@search_history, \@filter_history);
}

# Save history file.
# Writes search entries prefixed with '/' and filter entries prefixed with '&'.
sub save_history_file {
    my ($filepath, $search_history_aref, $filter_history_aref, $max_size) = @_;
    $max_size //= 100;
    return 0 unless defined $filepath && $filepath ne '';

    my @s = @{$search_history_aref // []};
    my @f = @{$filter_history_aref // []};

    @s = @s[max(0, @s - $max_size) .. $#s] if @s > $max_size;
    @f = @f[max(0, @f - $max_size) .. $#f] if @f > $max_size;

    if (open my $fh, '>', $filepath) {
        for my $entry (@s) {
            print $fh "/$entry\n";
        }
        for my $entry (@f) {
            print $fh "&$entry\n";
        }
        close $fh;
        return 1;
    }
    return 0;
}

# Perform one editing / navigation step on a prompt state hash ref.
# $state = {
#     buffer   => $string,
#     cursor   => $int,
#     history  => \@history,
#     hist_idx => $int_or_undef,
#     draft    => $string,
# }
sub prompt_edit_step {
    my ($state, $key) = @_;
    return unless defined $state && defined $key;

    $state->{buffer}   //= '';
    $state->{cursor}   //= length($state->{buffer});
    $state->{history}  //= [];
    $state->{draft}    //= '';

    my $buf  = \$state->{buffer};
    my $cur  = \$state->{cursor};
    my $hist = $state->{history};

    # Up Arrow or Ctrl-P (previous / older history)
    if ($key eq "\e[A" || $key eq "\x10") {
        if (@$hist) {
            if (!defined $state->{hist_idx}) {
                $state->{draft}    = $$buf;
                $state->{hist_idx} = $#$hist;
            } elsif ($state->{hist_idx} > 0) {
                $state->{hist_idx}--;
            }
            $$buf = $hist->[$state->{hist_idx}];
            $$cur = length($$buf);
        }
        return;
    }

    # Down Arrow or Ctrl-N (next / newer history)
    if ($key eq "\e[B" || $key eq "\x0e") {
        if (defined $state->{hist_idx}) {
            if ($state->{hist_idx} < $#$hist) {
                $state->{hist_idx}++;
                $$buf = $hist->[$state->{hist_idx}];
                $$cur = length($$buf);
            } else {
                $state->{hist_idx} = undef;
                $$buf = $state->{draft};
                $$cur = length($$buf);
            }
        }
        return;
    }

    # Left Arrow or Ctrl-B (backward char)
    if ($key eq "\e[D" || $key eq "\x02") {
        $$cur = max(0, $$cur - 1);
        return;
    }

    # Right Arrow or Ctrl-F (forward char)
    if ($key eq "\e[C" || $key eq "\x06") {
        $$cur = min(length($$buf), $$cur + 1);
        return;
    }

    # Home, Ctrl-A
    if ($key eq "\e[H" || $key eq "\e[1~" || $key eq "\x01") {
        $$cur = 0;
        return;
    }

    # End, Ctrl-E
    if ($key eq "\e[F" || $key eq "\e[4~" || $key eq "\e[OF" || $key eq "\x05") {
        $$cur = length($$buf);
        return;
    }

    # Backspace (delete before cursor)
    if ($key eq "\x7f" || $key eq "\x08") {
        if ($$cur > 0) {
            substr($$buf, $$cur - 1, 1, '');
            $$cur--;
        }
        return;
    }

    # Delete, Ctrl-D (delete character under cursor)
    if ($key eq "\e[3~" || $key eq "\x04") {
        if ($$cur < length($$buf)) {
            substr($$buf, $$cur, 1, '');
        }
        return;
    }

    # Ctrl-K (kill line to end)
    if ($key eq "\x0b") {
        if ($$cur < length($$buf)) {
            $$buf = substr($$buf, 0, $$cur);
        }
        return;
    }

    # Ctrl-U (kill line to beginning / clear entire line)
    if ($key eq "\x15") {
        $$buf = '';
        $$cur = 0;
        return;
    }

    # Ctrl-W (backward kill word: unix-word-rubout)
    if ($key eq "\x17") {
        if ($$cur > 0) {
            my $left  = substr($$buf, 0, $$cur);
            my $right = substr($$buf, $$cur);
            $left =~ s/\S+\s*$//;
            $$buf = $left . $right;
            $$cur = length($left);
        }
        return;
    }

    # Alt-B / Esc-b (backward word)
    if ($key eq "\eb" || $key eq "\eB") {
        if ($$cur > 0) {
            my $left = substr($$buf, 0, $$cur);
            if ($left =~ /^(.*?)(\S+)\s*$/) {
                $$cur = length($1);
            } else {
                $$cur = 0;
            }
        }
        return;
    }

    # Alt-F / Esc-f (forward word)
    if ($key eq "\ef" || $key eq "\eF") {
        if ($$cur < length($$buf)) {
            my $right = substr($$buf, $$cur);
            if ($right =~ /^\s*\S+/) {
                $$cur += length($&);
            } else {
                $$cur = length($$buf);
            }
        }
        return;
    }

    # Printable characters (ASCII 32 - 126, single char or pasted string)
    if ($key =~ /^[\x20-\x7e]+$/) {
        substr($$buf, $$cur, 0, $key);
        $$cur += length($key);
        return;
    }
}

# ------------------------------
# MAIN PROGRAM --- only runs when executed directly, not when required by tests
# ------------------------------
unless (caller()) {
    _main();
}

sub _main {
    $| = 1;  # autoflush STDOUT so every frame/status line prints immediately

    # ------ Argument parsing ------------------------------
    my ($opt_delim, $opt_csv, $opt_help, $opt_line_nums);
    $opt_line_nums = 0;
    $opt_help      = 0;
    GetOptions(
        'd|delimiter=s' => \$opt_delim,
        'c|csv'         => \$opt_csv,
        'N|numbers!'    => \$opt_line_nums,
        'help|h'        => \$opt_help,
    ) or usage();
    usage() if $opt_help;

    if ($opt_csv && defined $opt_delim) {
        print STDERR "t2v: Cannot specify both --csv and --delimiter\n";
        usage();
    }
    if ($opt_csv) {
        $opt_delim = ',';
    } else {
        $opt_delim //= "\t";
    }

    # ------ Load data ------------------------------
    my ($filename, @all_rows);

    if (!-t STDIN) {
        # Data arrives on STDIN (pipe); reopen STDIN from /dev/tty for keyboard.
        $filename = '<stdin>';
        if ($opt_csv) {
            while (my $line = <STDIN>) {
                push @all_rows, parse_csv_line($line, sub { scalar <STDIN> });
            }
        } else {
            while (my $line = <STDIN>) {
                chomp $line;
                push @all_rows, [split /\Q$opt_delim\E/, $line, -1];
            }
        }
        # Reopen STDIN for keyboard input.
        # Try /dev/tty first; if that fails (e.g. Device not configured in subshell pipelines),
        # fallback to the actual tty device path of STDOUT or STDERR.
        my $reopened = open(STDIN, '<', '/dev/tty');
        if (!$reopened) {
            my $tty = (-t STDOUT) ? POSIX::ttyname(fileno(\*STDOUT))
                    : (-t STDERR) ? POSIX::ttyname(fileno(\*STDERR))
                    : undef;
            $reopened = open(STDIN, '<', $tty) if defined $tty;
        }
        die "t2v: Cannot open terminal for interactive input: $!\n" unless $reopened;
    } elsif (@ARGV) {
        $filename = $ARGV[0];
        open(my $fh, '<', $filename) or die "t2v: Cannot open '$filename': $!\n";
        if ($opt_csv) {
            while (my $line = <$fh>) {
                push @all_rows, parse_csv_line($line, sub { scalar <$fh> });
            }
        } else {
            while (my $line = <$fh>) {
                chomp $line;
                push @all_rows, [split /\Q$opt_delim\E/, $line, -1];
            }
        }
        close $fh;
    } else {
        usage();
    }

    if (@all_rows == 0) {
        die "t2v: empty input\n";
    }

    # ------ Separate header + data ------------------------------
    my $header = $all_rows[0];
    my @data   = @all_rows[1 .. $#all_rows];
    my $n_rows = scalar @data;

    # Determine column count (max across header + all rows)
    my $n_cols = scalar @$header;
    for my $row (@data) {
        $n_cols = scalar(@$row) if scalar(@$row) > $n_cols;
    }
    push @$header, '' while @$header < $n_cols;  # pad header

    # ------ Column analysis ------------------------------
    my $col_widths_ref      = compute_col_widths(\@data, $header, $n_cols, MAX_ANALYSIS_ROWS);
    my $orig_col_widths_ref = [@$col_widths_ref];
    my $is_hidden_ref       = [(0) x $n_cols];
    my $is_numeric_ref      = detect_numeric(\@data, $n_cols, MAX_ANALYSIS_ROWS);

    # ------ Terminal size ------------------------------
    my ($term_rows, $term_cols) = _get_term_size();

    # ------ Terminal setup + cleanup ------------------------------
    my $history_file = defined $ENV{HOME} ? "$ENV{HOME}/.t2v_history" : undef;
    my ($search_history_ref, $filter_history_ref) = load_history_file($history_file);

    my $cleaned_up = 0;
    my $cleanup = sub {
        return if $cleaned_up++;
        save_history_file($history_file, $search_history_ref, $filter_history_ref, 100) if defined $history_file;
        ReadMode('restore');
        print "\e[?25h\e[?1049l";  # show cursor, restore screen
    };

    $SIG{INT}  = sub { $cleanup->(); exit 0 };
    $SIG{TERM} = sub { $cleanup->(); exit 0 };
    my $winch_flag = 0;
    $SIG{WINCH} = sub { $winch_flag = 1 };

    print "\e[?1049h\e[?25l";  # alt screen, hide cursor
    ReadMode('cbreak');

    # ------ Scroll, Search & Filter state ------------------------------
    my $v_offset                = 0;
    my $h_offset                = 0;
    my $show_help               = 0;
    my $show_line_nums          = $opt_line_nums;
    my $show_col_nums           = 0;
    my $col_base_idx            = 1;
    my $saved_show_col_nums     = 0;
    my $saved_col_base_idx      = 1;
    my $pending_line_num_toggle = 0;
    my $pending_dash            = 0;

    my $prompt_mode  = undef;  # undef, '/' for search, '&' for filter, 'w ' for width
    my $prompt_state = {
        buffer   => '',
        cursor   => 0,
        history  => [],
        hist_idx => undef,
        draft    => '',
    };

    my $filter_regex        = undef;
    my $visible_indices_ref = filter_rows(\@data, undef, $opt_delim);

    my $search_regex     = undef;
    my @search_matches   = ();
    my $search_match_idx = undef;
    my $status_msg       = undef;

    # Rows available for data (total rows minus non-data rows: header, status bar, and optional colnum row)
    my $n_filtered_rows   = sub { scalar @$visible_indices_ref };
    my $visible_data_rows = sub { $term_rows - ($show_col_nums ? 3 : 2) };
    my $max_v             = sub { max(0, $n_filtered_rows->() - $visible_data_rows->()) };
    my $max_h             = sub {
        my $avail = $show_line_nums ? max(1, $term_cols - (length($n_rows) + 1)) : $term_cols;
        max(0, total_line_width($col_widths_ref) - $avail);
    };

    my $execute_search = sub {
        my ($pattern) = @_;
        $status_msg = undef;
        if (!defined $pattern || $pattern eq '') {
            $search_regex     = undef;
            @search_matches   = ();
            $search_match_idx = undef;
            return;
        }

        my $compiled;
        eval {
            local $SIG{__DIE__} = sub {};
            $compiled = qr/$pattern/;
        };
        if ($@ || !$compiled) {
            $status_msg       = "Invalid regex: $pattern";
            $search_regex     = undef;
            @search_matches   = ();
            $search_match_idx = undef;
            return;
        }

        $search_regex   = $compiled;
        @search_matches = @{ find_matches(\@data, $n_cols, $search_regex, $opt_delim) };

        if (!@search_matches) {
            $status_msg       = "Pattern not found: $pattern";
            $search_match_idx = undef;
            return;
        }

        my ($idx, $wrapped) = find_next_match_index(\@search_matches, $v_offset - 1, 999999, 1);
        $search_match_idx = $idx // 0;
        my ($r, $c)       = @{ $search_matches[$search_match_idx] };

        if ($wrapped) {
            $status_msg = "Search wrapped to top";
        }

        my $vdr = $visible_data_rows->();
        my ($target_vis_idx) = grep { $visible_indices_ref->[$_] == $r } (0 .. $#$visible_indices_ref);
        $target_vis_idx //= $r;
        if ($target_vis_idx < $v_offset || $target_vis_idx >= $v_offset + $vdr) {
            $v_offset = clamp($target_vis_idx, 0, $max_v->());
        }

        my $col_start = 0;
        for my $ci (0 .. $c - 1) {
            $col_start += $col_widths_ref->[$ci] + 1;
        }
        my $col_w     = $col_widths_ref->[$c];
        my $ln_len    = $show_line_nums ? (length($n_rows) + 1) : 0;
        my $content_w = max(1, $term_cols - $ln_len);
        $h_offset     = compute_search_h_offset($col_start, $col_w, $content_w, $max_h->());
    };

    my $navigate_match = sub {
        my ($dir) = @_;
        return unless defined $search_regex && @search_matches;
        $status_msg = undef;

        my ($curr_r, $curr_c) = (defined $search_match_idx && $search_match_idx < @search_matches)
            ? @{ $search_matches[$search_match_idx] }
            : ($v_offset, -1);

        my ($idx, $wrapped) = find_next_match_index(\@search_matches, $curr_r, $curr_c, $dir);
        return unless defined $idx;

        $search_match_idx = $idx;
        my ($r, $c)       = @{ $search_matches[$search_match_idx] };

        if ($wrapped) {
            $status_msg = ($dir > 0) ? "Search wrapped to top" : "Search wrapped to bottom";
        }

        my $vdr = $visible_data_rows->();
        my ($target_vis_idx_nav) = grep { $visible_indices_ref->[$_] == $r } (0 .. $#$visible_indices_ref);
        $target_vis_idx_nav //= $r;
        if ($target_vis_idx_nav < $v_offset || $target_vis_idx_nav >= $v_offset + $vdr) {
            $v_offset = clamp($target_vis_idx_nav, 0, $max_v->());
        }

        my $col_start = 0;
        for my $ci (0 .. $c - 1) {
            $col_start += $col_widths_ref->[$ci] + 1;
        }
        my $col_w     = $col_widths_ref->[$c];
        my $ln_len    = $show_line_nums ? (length($n_rows) + 1) : 0;
        my $content_w = max(1, $term_cols - $ln_len);
        $h_offset     = compute_search_h_offset($col_start, $col_w, $content_w, $max_h->());
    };

    # ------ Inner render helpers ------------------------------
    my $draw_screen = sub {
        my $vdr       = $visible_data_rows->();
        my $output    = $HOME;
        my $ln_len    = $show_line_nums ? (length($n_rows) + 1) : 0;
        my $content_w = max(1, $term_cols - $ln_len);
        my $header_ln = $show_line_nums ? format_line_num(undef, $n_rows) : '';

        # Line 1: column numbers (bold) if enabled
        if ($show_col_nums) {
            my $colnum_raw     = build_colnum_line($col_widths_ref, $is_numeric_ref, $col_base_idx, $is_hidden_ref);
            my $colnum_clipped = clip_content($colnum_raw, $h_offset, $content_w);
            $output .= $BOLD . $header_ln . $colnum_clipped . $RESET . $CLEAR_EOL . "\n";
        }

        # Line 2: header (bold)
        my $header_raw     = build_row_line($header, $col_widths_ref, $is_numeric_ref, $is_hidden_ref);
        my $header_clipped = clip_content($header_raw, $h_offset, $content_w);
        $output .= $BOLD . $header_ln . $header_clipped . $RESET . $CLEAR_EOL . "\n";

        # Data rows
        my $active_match_tuple = (defined $search_match_idx && @search_matches)
            ? $search_matches[$search_match_idx]
            : undef;

        for my $i ($v_offset .. $v_offset + $vdr - 1) {
            if ($i < @$visible_indices_ref) {
                my $ri         = $visible_indices_ref->[$i];
                my $row        = $data[$ri];
                my @fields     = map { $row->[$_] // '' } (0 .. $n_cols - 1);
                my $row_prefix = $show_line_nums ? format_line_num($ri, $n_rows) : '';
                my $clipped    = render_clipped_row(
                    \@fields, $col_widths_ref, $is_numeric_ref,
                    $h_offset, $content_w, $ri, $search_regex, $active_match_tuple,
                    $opt_delim, $is_hidden_ref
                );
                $output .= $BOLD . $row_prefix . $RESET . $clipped . $CLEAR_EOL . "\n";
            } else {
                $output .= ' ' x $term_cols . $CLEAR_EOL . "\n";
            }
        }

        # Status bar or search/filter prompt or option prompt
        if (defined $prompt_mode) {
            my $prompt_prefix = $prompt_mode;
            my $buf           = $prompt_state->{buffer};
            my $prompt        = "$prompt_prefix$buf";
            if (length($prompt) > $term_cols) {
                $prompt = substr($prompt, 0, $term_cols);
            } else {
                $prompt .= ' ' x ($term_cols - length($prompt));
            }
            $output .= $GREEN_BAR . $prompt . $RESET;
            my $cur_col = clamp(length($prompt_prefix) + $prompt_state->{cursor} + 1, 1, $term_cols);
            $output .= "\e[${term_rows};${cur_col}H\e[?25h";
        } elsif (defined $status_msg) {
            my $is_err = $status_msg =~ /^(?:Error|Invalid|Pattern not found)/i;
            my $style  = $is_err ? "\e[7;31m" : "\e[7;33m";
            my $msg    = $status_msg;
            if (length($msg) > $term_cols) {
                $msg = substr($msg, 0, $term_cols);
            } else {
                $msg .= ' ' x ($term_cols - length($msg));
            }
            $output .= $style . $msg . $RESET . "\e[?25l";
        } elsif ($pending_line_num_toggle) {
            $output .= format_option_prompt($show_line_nums, $term_cols) . "\e[?25l";
        } elsif ($pending_dash) {
            my $dash_msg = '-';
            my $padded   = $dash_msg . ' ' x max(0, $term_cols - length($dash_msg));
            $output .= "\e[7;33m" . $padded . "\e[0m\e[?25l";
        } else {
            my $total_vis = scalar @$visible_indices_ref;
            my $first_r   = $total_vis > 0 ? $v_offset + 1                      : 0;
            my $last_r    = $total_vis > 0 ? min($v_offset + $vdr, $total_vis)  : 0;
            my $status    = sprintf(
                " Rows %d-%d of %d | Col offset: %d | %s",
                $first_r, $last_r, $total_vis, $h_offset, $filename
            );
            if (length($status) > $term_cols) {
                $status = substr($status, 0, $term_cols);
            } else {
                $status .= ' ' x ($term_cols - length($status));
            }
            $output .= $GREEN_BAR . $status . $RESET . "\e[?25l";
        }

        print $output;
    };

    my $draw_help = sub {
        my @lines = (
            '+-----------------------------+',
            '|        KEYBINDINGS          |',
            '+-----------------------------+',
            '|  Up/Down, k/j Scroll rows   |',
            '|  Left / Right Scroll 10ch   |',
            '|  Tab          Scroll 4/5 vp |',
            '|  Shift-Tab    Scroll 4/5 vp |',
            '|  b/C-b/<bksp> Scroll page   |',
            '|  f/C-f/<sp>   Scroll page   |',
            '|  g / Home     First row     |',
            '|  G / End      Last row      |',
            '|  /            Search regex  |',
            '|  &            Filter rows   |',
            '|  n            Next match    |',
            '|  p            Prev match    |',
            '|  1            1-based cols  |',
            '|  0            0-based cols  |',
            '|  w            Adjust width  |',
            '|  -N           Line numbers  |',
            '|  q            Quit          |',
            '|  h / ?        Toggle help   |',
            '|                             |',
            '|  Press any key to dismiss   |',
            '+-----------------------------+',
        );
        my $box_w   = length($lines[0]);
        my $box_h   = scalar @lines;
        my $start_r = int(($term_rows - $box_h) / 2);
        my $start_c = int(($term_cols - $box_w) / 2);
        for my $i (0 .. $box_h - 1) {
            printf "\e[%d;%dH%s%s",
                $start_r + $i + 1, $start_c + 1,
                $BOLD, $lines[$i];
        }
        print $RESET;
    };

    # ------ Key reader ------------------------------
    my $read_key = sub {
        my $ch = ReadKey(0);
        return $ch unless defined $ch && $ch eq "\e";
        my $seq = '';
        while (1) {
            my $c = ReadKey(-1);
            last unless defined $c;
            $seq .= $c;
            last if $c =~ /[A-Za-z~]/;
        }
        return "\e$seq";
    };

    # ------ Main loop ------------------------------
    $draw_screen->();

    while (1) {
        if ($winch_flag) {
            $winch_flag = 0;
            ($term_rows, $term_cols) = _get_term_size();
            $v_offset = clamp($v_offset, 0, $max_v->());
            $h_offset = clamp($h_offset, 0, $max_h->());
            $draw_screen->();
        }

        my $key = $read_key->();
        next unless defined $key;

        # Any key dismisses help overlay
        if ($show_help) {
            $show_help = 0;
            $draw_screen->();
            next;
        }

        if (defined $prompt_mode) {
            if ($key eq "\e" || $key eq "\x03") {
                if ($prompt_mode eq 'w' || $prompt_mode eq 'w ') {
                    $show_col_nums = $saved_show_col_nums;
                    $col_base_idx  = $saved_col_base_idx;
                }
                $prompt_mode = undef;
                $draw_screen->();
                next;
            } elsif ($key eq "\r" || $key eq "\n" || $key eq "\eOM") {
                my $mode  = $prompt_mode;
                my $query = $prompt_state->{buffer};
                $prompt_mode = undef;

                if (length($query) > 0) {
                    if ($mode eq '/') {
                        add_to_history($search_history_ref, $query, 100);
                    } elsif ($mode eq '&') {
                        add_to_history($filter_history_ref, $query, 100);
                    }
                    save_history_file($history_file, $search_history_ref, $filter_history_ref, 100) if defined $history_file;
                }

                if ($mode eq '/') {
                    $execute_search->($query);
                } elsif ($mode eq '&') {
                    $status_msg = undef;
                    if (!defined $query || $query eq '') {
                        $filter_regex        = undef;
                        $visible_indices_ref = filter_rows(\@data, undef, $opt_delim);
                    } else {
                        my $compiled;
                        eval {
                            local $SIG{__DIE__} = sub {};
                            $compiled = qr/$query/;
                        };
                        if ($@ || !$compiled) {
                            $status_msg = "Invalid regex: $query";
                        } else {
                            $filter_regex        = $compiled;
                            $visible_indices_ref = filter_rows(\@data, $filter_regex, $opt_delim);
                            if (!@$visible_indices_ref) {
                                $status_msg = "No rows match filter: $query";
                            }
                        }
                    }
                    $v_offset = 0;
                    $h_offset = clamp($h_offset, 0, $max_h->());
                } elsif ($mode eq 'w' || $mode eq 'w ') {
                    $show_col_nums = $saved_show_col_nums;
                    $col_base_idx  = $saved_col_base_idx;
                    $status_msg    = undef;
                    my ($ok, $msg) = adjust_column_widths(
                        $orig_col_widths_ref,
                        $col_widths_ref,
                        $is_hidden_ref,
                        $header,
                        $query,
                        $n_cols
                    );
                    if (!$ok) {
                        $status_msg = $msg;
                    }
                    $h_offset = clamp($h_offset, 0, $max_h->());
                }
                $draw_screen->();
                next;
            } else {
                prompt_edit_step($prompt_state, $key);
                $draw_screen->();
                next;
            }
        }

        $status_msg = undef;

        if ($pending_line_num_toggle) {
            $pending_line_num_toggle = 0;
            if ($key eq "\r" || $key eq "\n" || $key eq "\eOM") {
                $show_line_nums = !$show_line_nums;
                $h_offset = clamp($h_offset, 0, $max_h->());
            }
            $draw_screen->();
            next;
        }

        if ($pending_dash) {
            $pending_dash = 0;
            if ($key eq 'N' || $key eq 'n') {
                $pending_line_num_toggle = 1;
            } elsif ($key eq '&') {
                $prompt_mode  = '&';
                $prompt_state = { buffer => '', cursor => 0, history => $filter_history_ref, hist_idx => undef, draft => '' };
            }
            $draw_screen->();
            next;
        }

        if ($key eq 'q') {
            $cleanup->();
            exit 0;
        } elsif ($key eq '?' || $key eq 'h') {
            $show_help = 1;
            $draw_help->();
        } elsif ($key eq '/') {
            $prompt_mode  = '/';
            $prompt_state = { buffer => '', cursor => 0, history => $search_history_ref, hist_idx => undef, draft => '' };
            $draw_screen->();
        } elsif ($key eq '&' || $key eq '-&') {
            $prompt_mode  = '&';
            $prompt_state = { buffer => '', cursor => 0, history => $filter_history_ref, hist_idx => undef, draft => '' };
            $draw_screen->();
        } elsif ($key eq 'w') {
            $saved_show_col_nums = $show_col_nums;
            $saved_col_base_idx  = $col_base_idx;
            $show_col_nums       = 1;
            $col_base_idx        = 1;
            $prompt_mode         = 'w ';
            $prompt_state        = { buffer => '', cursor => 0, history => [], hist_idx => undef, draft => '' };
            $v_offset            = clamp($v_offset, 0, $max_v->());
            $draw_screen->();
        } elsif ($key eq 'n') {
            $navigate_match->(1);
            $draw_screen->();
        } elsif ($key eq 'p') {
            $navigate_match->(-1);
            $draw_screen->();
        } elsif ($key eq '1') {                       # Toggle 1-based column numbers
            if ($show_col_nums && $col_base_idx == 1) {
                $show_col_nums = 0;
            } else {
                $show_col_nums = 1;
                $col_base_idx  = 1;
            }
            $v_offset = clamp($v_offset, 0, $max_v->());
            $draw_screen->();
        } elsif ($key eq '0') {                       # Toggle 0-based column numbers
            if ($show_col_nums && $col_base_idx == 0) {
                $show_col_nums = 0;
            } else {
                $show_col_nums = 1;
                $col_base_idx  = 0;
            }
            $v_offset = clamp($v_offset, 0, $max_v->());
            $draw_screen->();
        } elsif ($key eq 'N' || $key eq 'n' || $key eq '-N' || $key eq '-n') {  # Toggle line numbers prompt
            $pending_line_num_toggle = 1;
            $draw_screen->();
        } elsif ($key eq '-') {
            $pending_dash = 1;
            $draw_screen->();
        } elsif ($key eq "\e[A" || $key eq 'k') {                    # Up / k
            $v_offset = clamp($v_offset - 1, 0, $max_v->());
            $draw_screen->();
        } elsif ($key eq "\e[B" || $key eq 'j') {                    # Down / j
            $v_offset = clamp($v_offset + 1, 0, $max_v->());
            $draw_screen->();
        } elsif ($key eq "\e[D") {                    # Left
            $h_offset = clamp($h_offset - H_SCROLL_STEP, 0, $max_h->());
            $draw_screen->();
        } elsif ($key eq "\e[C") {                    # Right
            $h_offset = clamp($h_offset + H_SCROLL_STEP, 0, $max_h->());
            $draw_screen->();
        } elsif ($key eq "\t") {                       # Tab - scroll right 4/5 viewport
            my $step = int($term_cols * 4 / 5) || 1;
            $h_offset = clamp($h_offset + $step, 0, $max_h->());
            $draw_screen->();
        } elsif ($key eq "\e[Z") {                     # Shift-Tab - scroll left 4/5 viewport
            my $step = int($term_cols * 4 / 5) || 1;
            $h_offset = clamp($h_offset - $step, 0, $max_h->());
            $draw_screen->();
        } elsif ($key eq "\e[5~" || $key eq "\x7f" || $key eq "\x08" || $key eq 'b' || $key eq "\x02") {   # PgUp / Backspace / b / Ctrl-B
            $v_offset = clamp($v_offset - $visible_data_rows->(), 0, $max_v->());
            $draw_screen->();
        } elsif ($key eq "\e[6~" || $key eq ' ' || $key eq 'f' || $key eq "\x06") {    # PgDn / Space / f / Ctrl-F
            $v_offset = clamp($v_offset + $visible_data_rows->(), 0, $max_v->());
            $draw_screen->();
        } elsif ($key eq "\e[H" || $key eq "\e[1~" || $key eq 'g') { # Home / g
            $v_offset = 0;
            $draw_screen->();
        } elsif ($key eq "\e[F" || $key eq "\e[4~" || $key eq 'G') { # End / G
            $v_offset = $max_v->();
            $draw_screen->();
        }
        # Ignore all other keys
    }
}

sub _get_term_size {
    my @s;
    eval {
        local $SIG{__WARN__} = sub {};
        @s = GetTerminalSize(\*STDOUT) if -t STDOUT;
        @s = GetTerminalSize(\*STDIN)  if !@s && -t STDIN;
    };
    return ($s[1] || 24, $s[0] || 80);  # (rows, cols)
}

